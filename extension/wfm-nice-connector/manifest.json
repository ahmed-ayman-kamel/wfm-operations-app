{
  "manifest_version": 3,
  "name": "WFM NICE Connector",
  "version": "1.1.0",
  "description": "Lets the WFM Operations App run NICE WebStation reports with your own NICE session (button-started, no stored passwords).",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://your-tenant.nicecloudsvc.com/*",
    "https://identity.cloudbreak.us/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.googleusercontent.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "WFM NICE Connector", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
